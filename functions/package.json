{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "build": "tsc",
    "serve": "npm run db:start && node scripts/wait-for-db.js && npm run migrate && npm run build && firebase emulators:start --import=../emulator-data --export-on-exit=../emulator-data",
    "start": "npm run shell",
    "db:start": "docker compose -f ../docker-compose.yml up -d",
    "db:stop": "docker compose -f ../docker-compose.yml down",
    "migrate": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate up",
    "migrate:down": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate down",
    "migrate:create": "node -r dotenv/config ./node_modules/.bin/node-pg-migrate create"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.1.0",
    "firebase-functions": "^6.3.2",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "@types/pg": "^8.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  },
  "private": true
}
